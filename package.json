{
	"name": "pulsar",
	"version": "2.0.0",
	"description": "Let your AI agents talk freely to each other - cross-harness, even cross-machine. Remote control them from any device, anywhere.",
	"keywords": [
		"mcp",
		"mcp-server",
		"model-context-protocol",
		"agents",
		"multi-agent",
		"agent-communication",
		"claude-code",
		"codex",
		"opencode",
		"pi-package",
		"omp"
	],
	"license": "MIT",
	"author": "Eric Schoffstall",
	"homepage": "https://github.com/yocontra/pulsar#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yocontra/pulsar.git"
	},
	"bugs": "https://github.com/yocontra/pulsar/issues",
	"mcpName": "io.github.yocontra/pulsar",
	"type": "module",
	"bin": {
		"pulsar": "dist/cli.js"
	},
	"exports": {
		"./extension": "./dist/extension.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"skills",
		"install.sh",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/extension.js"
		],
		"skills": [
			"./skills"
		]
	},
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"build": "rm -rf dist && bun build src/cli.ts src/extension.ts --target=node --format=esm --splitting --outdir dist && chmod +x dist/cli.js && bun run build:web",
		"build:web": "ASTRO_TELEMETRY_DISABLED=1 astro build --root web --silent && bun web/scripts/finish-dist.ts && bun web/scripts/check-dist.ts",
		"dev:web": "cd web && ASTRO_TELEMETRY_DISABLED=1 astro dev",
		"mock": "bun web/mock/server.ts",
		"typecheck": "bun scripts/typecheck.ts",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun scripts/test.ts",
		"test:mem": "bun run build && PULSAR_MEM_TEST=1 bun test test/memory.test.ts",
		"mem": "bun run build && node scripts/mem-report.ts",
		"test:e2e": "bun run build:web && playwright test -c web/playwright.config.ts && playwright test -c web/playwright.real.config.ts",
		"check": "bun run typecheck && bun run lint && bun run test",
		"prepublishOnly": "bun run check && bun run build"
	},
	"devDependencies": {
		"@astrojs/react": "7.1.9",
		"@biomejs/biome": "^2.6.8",
		"@hono/node-server": "^2.1.8",
		"@ionic/react": "9.0.11",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@playwright/test": "1.65.1",
		"@radix-ui/react-use-controllable-state": "1.3.0",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.0",
		"@stencil/react-output-target": "1.8.1",
		"@streamdown/code": "2.0.0",
		"@streamdown/math": "1.0.3",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/react-query": "5.108.0",
		"@tanstack/virtual-core": "3.13.23",
		"@types/bun": "latest",
		"@types/node": "^24.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"astro": "7.4.12",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"diff": "9.0.0",
		"hono": "^4.13.19",
		"jsonc-parser": "^3.3.1",
		"katex": "0.16.47",
		"konsta": "5.5.0",
		"lucide-react": "1.74.0",
		"mermaid": "11",
		"nanoid": "6.0.2",
		"prettier": "3.10.1",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rehype-harden": "1.1.8",
		"shiki": "4.6.0",
		"sonner": "2.0.8",
		"streamdown": "2.7.1",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.5",
		"tldts": "7.4.19",
		"typescript": "^5.9.3",
		"uqr": "0.1.3",
		"use-stick-to-bottom": "1.1.6",
		"zod": "^4.6.7"
	},
	"patchedDependencies": {
		"@ionic/core@9.0.11": "patches/@ionic%2Fcore@9.0.11.patch",
		"streamdown@2.7.1": "patches/streamdown@2.7.1.patch"
	}
}
